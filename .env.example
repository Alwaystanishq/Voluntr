# MongoDB connection string for your own database.
MONGODB_URI=mongodb://localhost:27017/voluntr

# Replace with a long random secret before running the app.
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# Use your deployed app URL in production.
NEXTAUTH_URL=http://localhost:3000

# Optional: comma-separated MongoDB account IDs for NGO verification reviewers.
# Leave empty to disable admin access.
ADMIN_USER_IDS=

# Optional event search cache. Leave empty to use MongoDB directly.
# Local Redis: redis://127.0.0.1:6379; hosted TLS: rediss://...
REDIS_URL=
